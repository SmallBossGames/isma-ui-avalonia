<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ISMA.BlueprintEditor.Controls.EditArrowPopOver">
  <Border Background="White"
          BorderBrush="#BBBBBB"
          BorderThickness="1"
          CornerRadius="5"
          Padding="10"
          MinWidth="300">
    <StackPanel Spacing="4">
      <TextBlock Text="Alias (optional)" />
      <TextBox x:Name="AliasBox" MinWidth="300" />
      <TextBlock Text="Predicate" />
      <TextBox x:Name="PredicateBox" MinWidth="300" />
    </StackPanel>
  </Border>
</UserControl>
