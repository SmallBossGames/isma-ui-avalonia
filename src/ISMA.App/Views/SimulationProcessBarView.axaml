<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ISMA.App.ViewModels"
             xmlns:views="using:ISMA.App.Views"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="ISMA.App.Views.SimulationProcessBarView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
        <StackPanel Orientation="Horizontal"
                    Spacing="4"
                    Margin="4">
            <Button ToolTip.Tip="Play"
                    AutomationProperties.AutomationId="ProcessBarRun"
                    VerticalAlignment="Stretch"
                    Command="{Binding RunCommand}">
                <ic:FluentIcon Icon="Play" IconVariant="Regular"/>
            </Button>

            <Button ToolTip.Tip="Simulation Tasks"
                    AutomationProperties.AutomationId="ProcessBarTasks"
                    Content="Tasks"
                    VerticalAlignment="Stretch">
                <Button.Flyout>
                    <Flyout>
                        <views:TasksPopOverView DataContext="{Binding TasksPopOver}" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
