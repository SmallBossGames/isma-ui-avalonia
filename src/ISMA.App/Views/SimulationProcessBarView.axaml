<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ISMA.App.ViewModels"
             xmlns:views="using:ISMA.App.Views"
             x:Class="ISMA.App.Views.SimulationProcessBarView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
        <StackPanel Orientation="Horizontal"
                    Spacing="4"
                    Margin="4"
                    Height="32">
            <Button ToolTip.Tip="Play"
                    AutomationProperties.AutomationId="ProcessBarRun"
                    Command="{Binding RunCommand}"
                    Width="32" Height="28"
                    Padding="0">
                <PathIcon Data="M8,5.14V19.14L19,12.14L8,5.14Z" Width="20" Height="20"/>
            </Button>

            <Button ToolTip.Tip="Simulation Tasks"
                    AutomationProperties.AutomationId="ProcessBarTasks"
                    Content="Tasks"
                    Width="80" Height="28"
                    Padding="0">
                <Button.Flyout>
                    <Flyout>
                        <views:TasksPopOverView DataContext="{Binding TasksPopOver}" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
