<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ISMA.App.ViewModels"
             xmlns:texteditors="using:ISMA.TextEditor"
             x:Class="ISMA.App.Views.IsmaTextEditorView"
             x:CompileBindings="False">
    <Panel>
        <texteditors:IsmaTextEditor x:Name="Editor" DataContext="{Binding}" />
    </Panel>
</UserControl>
