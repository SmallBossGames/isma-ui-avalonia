<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ISMA.App.ViewModels"
             x:Class="ISMA.App.Views.TasksPopOverView"
             x:CompileBindings="True"
             x:DataType="vm:TasksPopOverViewModel">

    <Border CornerRadius="6"
            Padding="12"
            MinWidth="340"
            MaxWidth="420"
            Background="{DynamicResource SystemControlBackgroundChromeMediumHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="1"
            BoxShadow="0 4 16 0 #80000000">

        <StackPanel Spacing="8">

            <!-- In progress Section -->
            <TextBlock Text="In progress"
                       FontWeight="Bold"
                       FontSize="14" />

            <ItemsControl ItemsSource="{Binding InProgress}"
                          MaxHeight="180">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InProgressSimulationViewModel">
                        <Border CornerRadius="4"
                                Padding="8"
                                Margin="0,2"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding TaskId, StringFormat='Task #{0}'}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="1"
                                             Value="{Binding Progress}"
                                             Minimum="0"
                                             Maximum="1"
                                             Height="6"
                                             Margin="6,0"
                                             VerticalAlignment="Center" />
                                <Button Grid.Column="2"
                                        ToolTip.Tip="Abort"
                                        Padding="4,0"
                                        Margin="6,0,0,0"
                                        Classes="accent"
                                        Command="{Binding AbortCommand}"
                                        IsEnabled="{Binding CanAbort}">
                                    <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                               Width="16" Height="16" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator />

            <!-- Completed Section -->
            <TextBlock Text="Completed"
                       FontWeight="Bold"
                       FontSize="14" />

            <ItemsControl ItemsSource="{Binding Completed}"
                          MaxHeight="160">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CompletedSimulationViewModel">
                        <Border CornerRadius="4"
                                Padding="8"
                                Margin="0,2"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding TaskId, StringFormat='Task #{0}'}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="1"
                                        Content="Show"
                                        Padding="8,3"
                                        FontSize="10"
                                        Margin="6,0,0,0"
                                        Command="{Binding ShowCommand}"
                                        AutomationProperties.AutomationId="SimulationShow"
                                        VerticalAlignment="Center" />

                                <Button Grid.Column="2"
                                        Content="Export"
                                        Padding="8,3"
                                        FontSize="10"
                                        Margin="4,0,0,0"
                                        Command="{Binding ExportCommand}"
                                        AutomationProperties.AutomationId="SimulationExport"
                                        VerticalAlignment="Center" />

                                <Button Grid.Column="3"
                                        Content="Remove"
                                        Padding="8,3"
                                        FontSize="10"
                                        Margin="4,0,0,0"
                                        Classes="danger"
                                        Command="{Binding RemoveCommand}"
                                        AutomationProperties.AutomationId="SimulationRemove"
                                        VerticalAlignment="Center" />

                                <Button Grid.Column="4"
                                        Padding="4,0"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Classes="chevron"
                                        ToolTip.Tip="Details"
                                        IsHitTestVisible="True">
                                    <PathIcon Data="M10,6L8.59,7.41L13.17,12L8.59,16.59L10,18L16,12L10,6Z"
                                               Width="16" Height="16" />
                                    <Button.Flyout>
                                        <Flyout>
                                            <Border CornerRadius="4"
                                                    Padding="10"
                                                    MinWidth="220"
                                                    MaxWidth="320"
                                                    Background="{DynamicResource SystemControlBackgroundChromeMediumHighBrush}"
                                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                                    BorderThickness="1"
                                                    BoxShadow="0 2 8 0 #60000000">
                                                <TextBlock Text="{Binding DetailsText}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator />

            <!-- Failed Section -->
            <TextBlock Text="Failed"
                       FontWeight="Bold"
                       FontSize="14" />

            <ItemsControl ItemsSource="{Binding Failed}"
                          MaxHeight="160">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FailedSimulationViewModel">
                        <Border CornerRadius="4"
                                Padding="8"
                                Margin="0,2"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding TaskId, StringFormat='Task #{0}'}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ErrorText}"
                                           FontSize="11"
                                           Foreground="Red"
                                           Margin="6,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2"
                                        Content="Remove"
                                        Padding="8,3"
                                        FontSize="10"
                                        Margin="6,0,0,0"
                                        Classes="danger"
                                        Command="{Binding RemoveCommand}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </Border>
</UserControl>
