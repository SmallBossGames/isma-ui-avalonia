<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ISMA.ViewModels.ViewModels"
             x:Class="ISMA.App.Views.TasksPopOverView"
             x:CompileBindings="True"
             x:DataType="vm:TasksPopOverViewModel">

    <Border CornerRadius="6"
            Padding="12"
            MinWidth="340"
            MaxWidth="420"
            Background="{DynamicResource SystemControlBackgroundChromeMediumHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="1"
            BoxShadow="0 4 16 0 #80000000">

        <StackPanel Spacing="8">

            <!-- In progress Section -->
            <TextBlock Text="In progress"
                       FontWeight="Bold"
                       FontSize="14" />

            <ItemsControl ItemsSource="{Binding InProgress}"
                          MaxHeight="180">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InProgressSimulationViewModel">
                        <Border CornerRadius="4"
                                Padding="8"
                                Margin="0,2"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding TaskId, StringFormat='Task #{0}'}"
                                           FontWeight="SemiBold"
                                           FontSize="12" />
                                <ProgressBar Value="{Binding Progress}"
                                             Minimum="0"
                                             Maximum="1"
                                             Height="6"
                                             Margin="0,2" />
                                <Button Content="Abort"
                                        Padding="12,3"
                                        FontSize="11"
                                        HorizontalAlignment="Right"
                                        Classes="accent"
                                        Command="{Binding AbortCommand}"
                                        IsEnabled="{Binding CanAbort}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator />

            <!-- Completed Section -->
            <TextBlock Text="Completed"
                       FontWeight="Bold"
                       FontSize="14" />

            <ItemsControl ItemsSource="{Binding Completed}"
                          MaxHeight="160">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CompletedSimulationViewModel">
                        <Border CornerRadius="4"
                                Padding="8"
                                Margin="0,2"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding TaskId, StringFormat='Task #{0}'}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="1"
                                        Content="Show"
                                        Padding="8,3"
                                        FontSize="10"
                                        Margin="6,0,0,0"
                                        Command="{Binding ShowCommand}"
                                        AutomationProperties.AutomationId="SimulationShow"
                                        VerticalAlignment="Center" />

                                <Button Grid.Column="2"
                                        Content="Export"
                                        Padding="8,3"
                                        FontSize="10"
                                        Margin="4,0,0,0"
                                        Command="{Binding ExportCommand}"
                                        AutomationProperties.AutomationId="SimulationExport"
                                        VerticalAlignment="Center" />

                                <Button Grid.Column="3"
                                        Content="Remove"
                                        Padding="8,3"
                                        FontSize="10"
                                        Margin="4,0,0,0"
                                        Classes="danger"
                                        Command="{Binding RemoveCommand}"
                                        AutomationProperties.AutomationId="SimulationRemove"
                                        VerticalAlignment="Center" />

                                <Button Grid.Column="4"
                                        Content="⋯"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Margin="8,0,0,0"
                                        Padding="4,0"
                                        VerticalAlignment="Center"
                                        Classes="chevron"
                                        ToolTip.Tip="Details"
                                        IsHitTestVisible="True">
                                    <Button.Flyout>
                                        <Flyout>
                                            <Border CornerRadius="4"
                                                    Padding="10"
                                                    MinWidth="220"
                                                    MaxWidth="320"
                                                    Background="{DynamicResource SystemControlBackgroundChromeMediumHighBrush}"
                                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                                    BorderThickness="1"
                                                    BoxShadow="0 2 8 0 #60000000">
                                                <TextBlock Text="{Binding DetailsText}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator />

            <!-- Failed Section -->
            <TextBlock Text="Failed"
                       FontWeight="Bold"
                       FontSize="14" />

            <ItemsControl ItemsSource="{Binding Failed}"
                          MaxHeight="160">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FailedSimulationViewModel">
                        <Border CornerRadius="4"
                                Padding="8"
                                Margin="0,2"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding TaskId, StringFormat='Task #{0}'}"
                                               FontWeight="SemiBold"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding ErrorText}"
                                               FontSize="11"
                                               Foreground="Red"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Remove"
                                        Padding="8,3"
                                        FontSize="10"
                                        Margin="6,0,0,0"
                                        Classes="danger"
                                        Command="{Binding RemoveCommand}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </Border>
</UserControl>
