<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="using:ISMA.ViewModels.ViewModels"
              x:Class="ISMA.App.Views.EditArrowPopOverView"
              x:CompileBindings="True"
              x:DataType="vm:EditArrowPopOverViewModel">

    <Border CornerRadius="5"
            Padding="10"
            MinWidth="300"
            Background="White"
            BorderBrush="#D3D3D3"
            BorderThickness="1"
            BoxShadow="0 0 20 5 #D3D3D3">
        <StackPanel Spacing="8">
            <StackPanel Spacing="4">
                <TextBlock Text="Alias (optional)"
                           FontSize="11"
                           Foreground="#333333"/>
                <TextBox Text="{Binding Alias, Mode=TwoWay}"
                         FontSize="11"
                         MinHeight="28"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Predicate"
                           FontSize="11"
                           Foreground="#333333"/>
                <TextBox Text="{Binding Predicate, Mode=TwoWay}"
                         FontSize="11"
                         MinHeight="28"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
