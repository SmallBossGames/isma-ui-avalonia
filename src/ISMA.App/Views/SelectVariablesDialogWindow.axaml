<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ISMA.App.ViewModels"
        xmlns:models="using:ISMA.App.Models"
        x:Class="ISMA.App.Views.SelectVariablesDialogWindow"
        x:CompileBindings="True"
        x:DataType="vm:SelectVariablesDialogViewModel"
        Title="Select Variables for Chart"
        Width="400"
        Height="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <!-- The list occupies the * row so it is height-constrained and scrolls;
         the action buttons always render below the list. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
          Margin="16">

        <!-- X-Axis Selection -->
        <TextBlock Grid.Row="0"
                   Text="X-Axis:"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />
        <ComboBox Grid.Row="1"
                  ItemsSource="{Binding AllColumns}"
                  SelectedItem="{Binding SelectedXAxis}"
                  HorizontalAlignment="Stretch"
                  Margin="0,0,0,8" />

        <!-- Y-Axis Multi-Select -->
        <TextBlock Grid.Row="2"
                   Text="Y-Axis (multi-select):"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />
        <ListBox Grid.Row="3"
                 ItemsSource="{Binding YAxisItems}"
                 MinHeight="160"
                 Margin="0,0,0,8">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:NamedPickerItem">
                    <CheckBox Content="{Binding Name}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Select All / Unselect All -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right">
            <Button Content="Select All"
                    Command="{Binding SelectAllCommand}" />
            <Button Content="Unselect All"
                    Command="{Binding UnselectAllCommand}" />
        </StackPanel>

        <!-- OK / Cancel -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="OK"
                    Width="70"
                    Command="{Binding OkCommand}" />
            <Button Content="Cancel"
                    Width="70"
                    Command="{Binding CloseCommand}" />
        </StackPanel>

    </Grid>
</Window>
