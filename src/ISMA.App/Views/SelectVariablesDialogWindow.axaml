<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ISMA.App.ViewModels"
        xmlns:models="using:ISMA.App.Models"
        x:Class="ISMA.App.Views.SelectVariablesDialogWindow"
        x:CompileBindings="True"
        x:DataType="vm:SelectVariablesDialogViewModel"
        Title="Select Variables for Chart"
        Width="400"
        Height="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          Margin="16">

        <!-- X-Axis Selection -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
            <TextBlock Text="X-Axis:" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding AllColumns}"
                      SelectedItem="{Binding SelectedXAxis}"
                      HorizontalAlignment="Stretch" />
        </StackPanel>

        <!-- Y-Axis Multi-Select -->
        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="Y-Axis (multi-select):" FontWeight="SemiBold" />
            <ListBox ItemsSource="{Binding YAxisItems}"
                     MinHeight="200">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:NamedPickerItem">
                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- Select All / Unselect All -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,8,0,0">
            <Button Content="Select All"
                    Command="{Binding SelectAllCommand}" />
            <Button Content="Unselect All"
                    Command="{Binding UnselectAllCommand}" />
        </StackPanel>

        <!-- OK / Cancel -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="OK"
                    Width="70"
                    Command="{Binding OkCommand}" />
            <Button Content="Cancel"
                    Width="70"
                    Command="{Binding CloseCommand}" />
        </StackPanel>

    </Grid>
</Window>
