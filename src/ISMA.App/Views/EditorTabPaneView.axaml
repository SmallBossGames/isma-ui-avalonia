<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="using:ISMA.ViewModels.ViewModels"
              xmlns:views="using:ISMA.App.Views"
              x:Class="ISMA.App.Views.EditorTabPaneView"
              x:CompileBindings="True"
              x:DataType="vm:MainWindowViewModel">
    <TabControl ItemsSource="{Binding Projects}"
                SelectedItem="{Binding ActiveProject}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1">
        <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:IProjectViewModel">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text=" *" IsVisible="{Binding IsDirty}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
                </StackPanel>
            </DataTemplate>
        </TabControl.ItemTemplate>

        <TabControl.DataTemplates>
             <DataTemplate x:DataType="vm:LismaProjectViewModel">
                 <views:IsmaTextEditorView DataContext="{Binding}" />
             </DataTemplate>
             <DataTemplate x:DataType="vm:BlueprintProjectViewModel">
                 <ContentControl Content="{Binding EditorContent}" />
             </DataTemplate>
         </TabControl.DataTemplates>
     </TabControl>
</UserControl>
