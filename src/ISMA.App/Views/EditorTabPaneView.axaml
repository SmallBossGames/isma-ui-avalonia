<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="using:ISMA.App.ViewModels"
              xmlns:views="using:ISMA.App.Views"
              xmlns:ic="using:FluentIcons.Avalonia"
              x:Class="ISMA.App.Views.EditorTabPaneView"
              x:CompileBindings="True"
              x:DataType="vm:MainWindowViewModel">
    <TabControl ItemsSource="{Binding Projects}"
                SelectedItem="{Binding ActiveProject}"
                AutomationProperties.AutomationId="EditorTabPane">
        <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:IProjectViewModel">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Name}" />
                    <Button Width="16"
                            Height="16"
                            Padding="0"
                            Margin="2,0,0,0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip.Tip="Close tab"
                            AutomationProperties.AutomationId="TabCloseButton"
                            Command="{Binding $parent[TabControl].DataContext.CloseTabCommand, x:DataType=vm:MainWindowViewModel}"
                            CommandParameter="{Binding }">
                        <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="12"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </Button>
                </StackPanel>
            </DataTemplate>
        </TabControl.ItemTemplate>

        <TabControl.DataTemplates>
             <DataTemplate x:DataType="vm:LismaProjectViewModel">
                 <views:IsmaTextEditorView DataContext="{Binding}" />
             </DataTemplate>
             <DataTemplate x:DataType="vm:BlueprintProjectViewModel">
                  <ContentControl Content="{Binding Editor}" />
              </DataTemplate>
         </TabControl.DataTemplates>
     </TabControl>
</UserControl>
