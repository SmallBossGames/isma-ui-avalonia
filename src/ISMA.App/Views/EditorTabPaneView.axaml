<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="using:ISMA.ViewModels.ViewModels"
              xmlns:views="using:ISMA.App.Views"
              x:Class="ISMA.App.Views.EditorTabPaneView"
              x:CompileBindings="True"
              x:DataType="vm:MainWindowViewModel">
    <TabControl ItemsSource="{Binding Projects}"
                SelectedItem="{Binding ActiveProject}"
                AutomationProperties.AutomationId="EditorTabPane">
        <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:IProjectViewModel">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Name}" />
                    <Button Width="16"
                            Height="16"
                            Padding="0"
                            Margin="2,0,0,0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip.Tip="Close tab"
                            AutomationProperties.AutomationId="TabCloseButton"
                            Command="{Binding $parent[TabControl].DataContext.CloseTabCommand, x:DataType=vm:MainWindowViewModel}"
                            CommandParameter="{Binding }">
                        <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                                  FontSize="10"
                                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </Button>
                </StackPanel>
            </DataTemplate>
        </TabControl.ItemTemplate>

        <TabControl.DataTemplates>
             <DataTemplate x:DataType="vm:LismaProjectViewModel">
                 <views:IsmaTextEditorView DataContext="{Binding}" />
             </DataTemplate>
             <DataTemplate x:DataType="vm:BlueprintProjectViewModel">
                  <views:BlueprintEditorView DataContext="{Binding EditorContent}" />
              </DataTemplate>
         </TabControl.DataTemplates>
     </TabControl>
</UserControl>
