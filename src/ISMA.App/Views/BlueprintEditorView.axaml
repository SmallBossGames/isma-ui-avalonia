<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="using:ISMA.ViewModels.ViewModels"
              xmlns:controls="using:ISMA.App.Controls"
              xmlns:converters="using:ISMA.ViewModels.Converters"
              xmlns:controlsPresenters="using:Avalonia.Controls.Presenters"
              x:Class="ISMA.App.Views.BlueprintEditorView"
              x:Name="__root"
              x:CompileBindings="True"
              x:DataType="vm:BlueprintEditorViewModel">

    <Design.PreviewWith>
        <Border Background="#F5F5F5" Width="800" Height="500">
            <TextBlock Text="Blueprint Editor"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Foreground="#999999"/>
        </Border>
    </Design.PreviewWith>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="EditorTabs" Grid.Row="0"
                    SelectionChanged="OnEditorTabsSelectionChanged">
            <TabItem x:Name="DiagramTab" Header="Diagram">
                <ScrollViewer x:Name="CanvasScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="White">
                    <Canvas x:Name="Canvas"
                            Width="{Binding CanvasSize.Width}"
                            Height="{Binding CanvasSize.Height}"
                            AutomationProperties.AutomationId="BlueprintCanvas"
                            Background="White">

                        <!-- Transaction arrows layer (ZIndex 0 - behind states) -->
                        <ItemsControl x:Name="TransitionsItemsControl"
                                      ZIndex="0"
                                      ItemsSource="{Binding Transitions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerTheme>
                                <ControlTheme TargetType="ContentControl" x:DataType="vm:BlueprintTransitionViewModel">
                                    <Setter Property="Canvas.Left" Value="0"/>
                                    <Setter Property="Canvas.Top" Value="0"/>
                                </ControlTheme>
                            </ItemsControl.ItemContainerTheme>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BlueprintTransitionViewModel">
                                    <controls:ArrowLine Id="{Binding Id}"
                                                        StartStateId="{Binding StartStateId}"
                                                        EndStateId="{Binding EndStateId}"
                                                        StartStatePosition="{Binding StartStatePosition}"
                                                        EndStatePosition="{Binding EndStatePosition}"
                                                        Alias="{Binding Alias}"
                                                        Predicate="{Binding Predicate}"
                                                        ArrowHeadClicked="OnArrowHeadClicked"
                                                        ArrowBodyClicked="OnArrowBodyClicked"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Loop arrows layer (ZIndex 0 - behind states) -->
                        <ItemsControl x:Name="LoopTransactionsItemsControl"
                                      ZIndex="0"
                                      ItemsSource="{Binding LoopTransactions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerTheme>
                                <ControlTheme TargetType="ContentControl" x:DataType="vm:BlueprintLoopTransactionViewModel">
                                    <Setter Property="Canvas.Left" Value="0"/>
                                    <Setter Property="Canvas.Top" Value="0"/>
                                </ControlTheme>
                            </ItemsControl.ItemContainerTheme>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BlueprintLoopTransactionViewModel">
                                    <controls:LoopArrow StateId="{Binding StateId}"
                                                        StatePosition="{Binding StatePosition}"
                                                        PositionResolver="{Binding PositionResolver}"
                                                        Alias="{Binding Alias}"
                                                        Predicate="{Binding Predicate}"
                                                        LoopArrowDoubleClick="OnLoopArrowDoubleClick"
                                                        LoopBodyClicked="OnLoopBodyClicked"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Main state (ZIndex 1 - on top of arrows) -->
                        <controls:StateBox Id="{Binding MainState.Id}"
                                           Width="110"
                                           Height="{Binding MainState.StateHeight}"
                                           FillColor="{Binding MainState.FillColor}"
                                           Canvas.Left="{Binding MainState.CanvasPositionX}"
                                           Canvas.Top="{Binding MainState.CanvasPositionY}"
                                           IsEditable="{Binding MainState.IsEditable}"
                                           IsEnabled="True"
                                           StateHeight="{Binding MainState.StateHeight}"
                                           Name="{Binding MainState.Name}"
                                           CanvasPositionX="{Binding MainState.CanvasPositionX, Mode=TwoWay}"
                                           CanvasPositionY="{Binding MainState.CanvasPositionY, Mode=TwoWay}"
                                           AutomationProperties.AutomationId="MainState"
                                                                                      StateClicked="OnStateBoxStateClicked"
                                           StateDoubleClicked="OnStateBoxStateDoubleClicked"
                                           NameCommitted="OnStateBoxNameCommitted"/>

                        <!-- Init state (ZIndex 1 - on top of arrows) -->
                        <controls:StateBox Id="{Binding InitState.Id}"
                                           Width="110"
                                           Height="{Binding InitState.StateHeight}"
                                           FillColor="{Binding InitState.FillColor}"
                                           Canvas.Left="{Binding InitState.CanvasPositionX}"
                                           Canvas.Top="{Binding InitState.CanvasPositionY}"
                                           IsEditable="{Binding InitState.IsEditable}"
                                           IsEnabled="True"
                                           StateHeight="{Binding InitState.StateHeight}"
                                           Name="{Binding InitState.Name}"
                                           CanvasPositionX="{Binding InitState.CanvasPositionX, Mode=TwoWay}"
                                           CanvasPositionY="{Binding InitState.CanvasPositionY, Mode=TwoWay}"
                                           AutomationProperties.AutomationId="InitState"
                                                                                      StateClicked="OnStateBoxStateClicked"
                                           StateDoubleClicked="OnStateBoxStateDoubleClicked"
                                           NameCommitted="OnStateBoxNameCommitted"/>

                        <!-- States layer (ZIndex 1 - on top of arrows) -->
                        <ItemsControl x:Name="StatesItemsControl"
                                      ZIndex="1"
                                      ItemsSource="{Binding States}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BlueprintStateViewModel">
                                    <Canvas Canvas.Left="{Binding CanvasPositionX}" Canvas.Top="{Binding CanvasPositionY}">
                                        <controls:StateBox Id="{Binding Id}"
                                                           Width="110"
                                                           Height="{Binding StateHeight}"
                                                    FillColor="{Binding FillColor}"
                                                    IsEditable="{Binding IsEditable}"
                                                    StateHeight="{Binding StateHeight}"
                                                           Name="{Binding Name}"
                                                           CanvasPositionX="{Binding CanvasPositionX, Mode=TwoWay}"
                                                           CanvasPositionY="{Binding CanvasPositionY, Mode=TwoWay}"
                                                           AutomationProperties.AutomationId="{Binding Name}"
                                                                                                                      StateClicked="OnStateBoxStateClicked"
                                                           StateDoubleClicked="OnStateBoxStateDoubleClicked"
                                                           NameCommitted="OnStateBoxNameCommitted"/>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </Canvas>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border x:Name="ToolbarBorder" Grid.Row="1"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <StackPanel Orientation="Horizontal"
                        Spacing="4"
                        Margin="8,4">

                <Button x:Name="AddStateButton" Content="New state"
                        Command="{Binding AddStateCommand}"
                        AutomationProperties.AutomationId="BlueprintNewState">
                    <Button.Styles>
                        <Style Selector="Button">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </Button.Styles>
                </Button>

                <ToggleButton x:Name="AddTransitionToggle" Content="{Binding AddTransitionButtonContent}"
                              Command="{Binding SetAddTransitionModeCommand}"
                              AutomationProperties.AutomationId="BlueprintAddTransition"
                              ToolTip.Tip="Enter Add Transition mode"/>

                <Separator/>

                <ToggleButton x:Name="RemoveStateToggle" Content="{Binding RemoveStateButtonContent}"
                              Command="{Binding SetRemoveStateModeCommand}"
                              AutomationProperties.AutomationId="BlueprintRemoveState"
                              ToolTip.Tip="Enter Remove State mode"/>

                <ToggleButton x:Name="RemoveTransitionToggle" Content="{Binding RemoveTransitionButtonContent}"
                              Command="{Binding SetRemoveTransitionModeCommand}"
                              AutomationProperties.AutomationId="BlueprintRemoveTransition"
                              ToolTip.Tip="Enter Remove Transition mode"/>

            </StackPanel>
        </Border>

        <Popup x:Name="EditArrowPopup"
               IsOpen="{Binding IsPopOverOpen}"
               IsLightDismissEnabled="True"
               VerticalOffset="2">
        </Popup>
    </Grid>

</UserControl>
