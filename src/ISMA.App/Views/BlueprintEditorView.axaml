<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="using:ISMA.ViewModels.ViewModels"
              xmlns:controls="using:ISMA.App.Controls"
              xmlns:converters="using:ISMA.ViewModels.Converters"
              x:Class="ISMA.App.Views.BlueprintEditorView"
              x:CompileBindings="True"
              x:DataType="vm:BlueprintEditorViewModel">

    <Design.PreviewWith>
        <Border Background="#F5F5F5" Width="800" Height="500">
            <TextBlock Text="Blueprint Editor"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Foreground="#999999"/>
        </Border>
    </Design.PreviewWith>

   <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="White">
            <Canvas x:Name="Canvas"
                    Width="1200"
                    Height="800"
                    Background="White"
                    PointerMoved="OnCanvasPointerMoved"
                    PointerReleased="OnCanvasPointerReleased"
                    PointerExited="OnCanvasPointerExited">

                <!-- Transaction arrows layer -->
                <ItemsControl ItemsSource="{Binding Transactions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="1200" Height="800"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BlueprintTransactionViewModel">
                            <controls:ArrowLine StartState="{Binding StartState}"
                                                EndState="{Binding EndState}"
                                                Alias="{Binding Alias}"
                                                Predicate="{Binding Predicate}"
                                                ArrowHeadClicked="OnArrowHeadClicked"
                                                ArrowBodyClicked="OnArrowBodyClicked"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Loop arrows layer -->
                <ItemsControl ItemsSource="{Binding LoopTransactions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="1200" Height="800"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BlueprintLoopTransactionViewModel">
                            <controls:LoopArrow Canvas.Left="{Binding State.CanvasPositionX}"
                                                Canvas.Top="{Binding State.CanvasPositionY}"
                                                State="{Binding State}"
                                                Alias="{Binding Alias}"
                                                Predicate="{Binding Predicate}"
                                                LoopArrowHeadClicked="OnLoopArrowHeadClickedEvent"
                                                LoopBodyClicked="OnLoopBodyClicked"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- States layer -->
                <ItemsControl ItemsSource="{Binding States}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="1200" Height="800"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BlueprintStateViewModel">
                            <Border Width="110"
                                    Height="{Binding StateHeight}"
                                    Background="{Binding FillColorHex}"
                                    BorderBrush="{Binding IsSelected,
                                         Converter={StaticResource BoolToBrushConverter}}"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    Canvas.Left="{Binding CanvasPositionX}"
                                    Canvas.Top="{Binding CanvasPositionY}"
                                    BoxShadow="2 2 4 0 #4D000000"
                                    PointerPressed="OnStatePointerPressed">
                                <TextBlock Text="{Binding Name}"
                                           FontFamily="Arial"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Canvas>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <StackPanel Orientation="Horizontal"
                        Spacing="4"
                        Margin="8,4">

                <Button Content="New state"
                        Command="{Binding AddStateCommand}"
                        IsVisible="{Binding IsDefaultMode}">
                    <Button.Styles>
                        <Style Selector="Button">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </Button.Styles>
                </Button>

                <Separator/>

                <ToggleButton Content="{Binding AddTransitionButtonContent}"
                              IsChecked="{Binding IsAddTransitionMode}"
                              ToolTip.Tip="Enter Add Transition mode"/>

                <ToggleButton Content="{Binding RemoveStateButtonContent}"
                              IsChecked="{Binding IsRemoveStateMode}"
                              ToolTip.Tip="Enter Remove State mode"/>

                <ToggleButton Content="{Binding RemoveTransitionButtonContent}"
                              IsChecked="{Binding IsRemoveTransitionMode}"
                              ToolTip.Tip="Enter Remove Transition mode"/>

            </StackPanel>
        </Border>

        <Popup x:Name="EditArrowPopup"
               Grid.RowSpan="2"
               Placement="Top"
               IsLightDismissEnabled="True"
               VerticalOffset="2">
        </Popup>
    </Grid>

</UserControl>
