<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ISMA.ViewModels.ViewModels"
             x:Class="ISMA.App.Views.IsmaErrorListTableView"
             x:CompileBindings="True"
             x:DataType="vm:ErrorListViewModel">
    <DataGrid ItemsSource="{Binding Errors}"
              AutoGenerateColumns="False"
              IsReadOnly="True">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Row" Width="5*" Binding="{Binding Row}" />
            <DataGridTextColumn Header="Pos" Width="5*" Binding="{Binding Position}" />
            <DataGridTextColumn Header="Fragment" Width="10*" Binding="{Binding FragmentName}" />
            <DataGridTextColumn Header="Message" Width="80*" Binding="{Binding Message}" />
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
