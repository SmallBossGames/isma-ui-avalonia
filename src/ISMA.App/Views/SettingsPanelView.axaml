<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ISMA.ViewModels.ViewModels"
             xmlns:controls="using:ISMA.App.Controls"
             x:Class="ISMA.App.Views.SettingsPanelView"
             x:CompileBindings="True"
             x:DataType="vm:SimulationParametersViewModel">
    <StackPanel Spacing="8" Margin="8" Width="240">
        <Expander Header="Initials" IsExpanded="True">
            <controls:PropertiesGrid ViewModel="{Binding CauchyInitials}" AutomationPrefix="Settings-CauchyInitials">
                <controls:PropertiesGrid.Rows>
                    <controls:PropertyRowSpec Label="Start" PropertyName="StartTime"/>
                    <controls:PropertyRowSpec Label="End" PropertyName="EndTime"/>
                    <controls:PropertyRowSpec Label="Step" PropertyName="InitialStep"/>
                </controls:PropertiesGrid.Rows>
            </controls:PropertiesGrid>
        </Expander>
        <Expander Header="Integration" IsExpanded="True">
            <controls:PropertiesGrid ViewModel="{Binding IntegrationMethod}" AutomationPrefix="Settings-IntegrationMethod">
                <controls:PropertiesGrid.Rows>
                    <controls:PropertyRowSpec Label="Method" PropertyName="SelectedMethod" ItemsSource="IntegrationMethods" SelectionProperty="SelectedMethodIndex"/>
                    <controls:PropertyRowSpec Label="Accurate" PropertyName="IsAccuracyInUse"/>
                    <controls:PropertyRowSpec Label="Accuracy" PropertyName="Accuracy" EnabledWhen="IsAccuracyInUse"/>
                    <controls:PropertyRowSpec Label="Stable" PropertyName="IsStableInUse"/>
                    <controls:PropertyRowSpec Label="Parallel" PropertyName="IsParallelInUse"/>
                    <controls:PropertyRowSpec Label="Server" PropertyName="Server" EnabledWhen="IsParallelInUse"/>
                    <controls:PropertyRowSpec Label="Port" PropertyName="Port" EnabledWhen="IsParallelInUse"/>
                </controls:PropertiesGrid.Rows>
            </controls:PropertiesGrid>
        </Expander>
        <Expander Header="Event detection" IsExpanded="True">
            <controls:PropertiesGrid ViewModel="{Binding EventDetection}" AutomationPrefix="Settings-EventDetection">
                <controls:PropertiesGrid.Rows>
                    <controls:PropertyRowSpec Label="In use" PropertyName="IsEventDetectionInUse"/>
                    <controls:PropertyRowSpec Label="Gamma" PropertyName="Gamma" EnabledWhen="IsEventDetectionInUse"/>
                    <controls:PropertyRowSpec Label="Step limit" PropertyName="IsStepLimitInUse"/>
                    <controls:PropertyRowSpec Label="Low border" PropertyName="LowBorder" EnabledWhen="IsStepLimitInUse"/>
                </controls:PropertiesGrid.Rows>
            </controls:PropertiesGrid>
        </Expander>
        <Expander Header="Result saving" IsExpanded="True">
            <controls:PropertiesGrid ViewModel="{Binding ResultSaving}" AutomationPrefix="Settings-ResultSaving">
                <controls:PropertiesGrid.Rows>
                    <controls:PropertyRowSpec Label="Save result" PropertyName="SavingTarget"/>
                </controls:PropertiesGrid.Rows>
            </controls:PropertiesGrid>
        </Expander>
    </StackPanel>
</UserControl>
