<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ISMA.ViewModels.ViewModels"
             xmlns:controls="using:ISMA.App.Controls"
             x:Class="ISMA.App.Views.SettingsPanelView"
             x:CompileBindings="True"
             x:DataType="vm:SimulationParametersViewModel">
    <StackPanel>
        <Border Width="240" Padding="8">
            <controls:PropertiesGrid ViewModel="{Binding CauchyInitials}" AutomationPrefix="Settings-CauchyInitials" />
        </Border>
        <Border Width="240" Padding="8">
            <controls:PropertiesGrid ViewModel="{Binding IntegrationMethod}" AutomationPrefix="Settings-IntegrationMethod" />
        </Border>
        <Border Width="240" Padding="8">
            <controls:PropertiesGrid ViewModel="{Binding EventDetection}" AutomationPrefix="Settings-EventDetection" />
        </Border>
        <Border Width="240" Padding="8">
            <controls:PropertiesGrid ViewModel="{Binding ResultSaving}" AutomationPrefix="Settings-ResultSaving" />
        </Border>
        <Border Width="240" Padding="8">
            <controls:PropertiesGrid ViewModel="{Binding ResultProcessing}" AutomationPrefix="Settings-ResultProcessing" />
        </Border>
    </StackPanel>
</UserControl>
