<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ISMA.ViewModels.ViewModels"
             x:Class="ISMA.App.Views.IsmaToolBarView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
        <StackPanel Orientation="Horizontal"
                    Spacing="2"
                    Margin="2,0">
            <Button ToolTip.Tip="New model"
                    AutomationProperties.AutomationId="ToolBarNewText"
                    Command="{Binding NewTextCommand}"
                    Padding="4,2">
                <PathIcon Width="20" Height="20"
                          Data="M13,7H11V11H7V13H11V17H13V13H17V11H13V7M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20Z"/>
            </Button>
            <Button ToolTip.Tip="New statechart"
                    AutomationProperties.AutomationId="ToolBarNewBlueprint"
                    Command="{Binding NewBlueprintCommand}"
                    Padding="4,2">
                <PathIcon Width="20" Height="20"
                          Data="M19,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M18,14H14V18H10V14H6V10H10V6H14V10H18V14Z"/>
            </Button>
            <Button ToolTip.Tip="Open model"
                    AutomationProperties.AutomationId="ToolBarOpen"
                    Command="{Binding OpenCommand}"
                    Padding="4,2">
                <PathIcon Width="20" Height="20"
                          Data="M20,6H12L10,4H4C2.9,4 2,4.9 2,6V18C2,19.1 2.9,20 4,20H20C21.1,20 22,19.1 22,18V8C22,6.9 21.1,6 20,6M20,18H4V8H20V18Z"/>
            </Button>
            <Button ToolTip.Tip="Save current model"
                    AutomationProperties.AutomationId="ToolBarSave"
                    Command="{Binding SaveCommand}"
                    Padding="4,2">
                <PathIcon Width="20" Height="20"
                          Data="M17,3H5C3.89,3 3,3.89 3,5V19C3,20.1 3.89,21 5,21H19C20.1,21 21,20.1 21,19V7L17,3M19,19H5V5H16.17L19,7.83V19M12,12H17V8H12V12M6,12H10V8H6V12Z"/>
            </Button>
            <Button ToolTip.Tip="Save all models"
                    AutomationProperties.AutomationId="ToolBarSaveAll"
                    Command="{Binding SaveAllCommand}"
                    Padding="4,2">
                <PathIcon Width="20" Height="20"
                          Data="M19,12V19H5V12H3V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V12H19M13,12.67V6.82L15.38,12H13M5,3C4.45,3 4,3.45 4,4V9H6V4H18V9H20V4C20,3.45 19.55,3 19,3H5Z"/>
            </Button>
            <Separator/>
            <Button ToolTip.Tip="Cut"
                    AutomationProperties.AutomationId="ToolBarCut"
                    Command="{Binding CutCommand}"
                    Padding="4,2">
                <PathIcon Width="20" Height="20"
                          Data="M9.64,7.64C9.87,7.14 10,6.59 10,6C10,3.79 8.21,2 6,2C3.79,2 2,3.79 2,6C2,8.21 3.79,10 6,10C6.59,10 7.14,9.87 7.64,9.64L10,12L7.64,14.36C7.14,14.13 6.59,14 6,14C3.79,14 2,15.79 2,18C2,20.21 3.79,22 6,22C8.21,22 10,20.21 10,18C10,17.41 9.87,16.86 9.64,16.36L12,14L19,21H22V20L9.64,7.64M6,8C4.9,8 4,7.11 4,6C4,4.9 4.9,4 6,4C7.1,4 8,4.9 8,6C8,7.1 7.1,8 6,8M6,20C4.9,20 4,19.1 4,18C4,16.9 4.9,16 6,16C7.1,16 8,16.9 8,18C8,19.1 7.1,20 6,20M12,12.5C11.72,12.5 11.5,12.28 11.5,12C11.5,11.72 11.72,11.5 12,11.5C12.28,11.5 12.5,11.72 12.5,12C12.5,12.28 12.28,12.5 12,12.5M19,3L13,9L15,11L22,4V3H19Z"/>
            </Button>
            <Button ToolTip.Tip="Copy"
                    AutomationProperties.AutomationId="ToolBarCopy"
                    Command="{Binding CopyCommand}"
                    Padding="4,2">
                <PathIcon Width="20" Height="20"
                          Data="M16,1H4C2.9,1 2,1.9 2,3V17H4V3H16V1M19,5H8C6.9,5 6,5.9 6,7V21C6,22.1 6.9,23 8,23H19C20.1,23 21,22.1 21,21V7C21,5.9 20.1,5 19,5M19,21H8V7H19V21Z"/>
            </Button>
            <Button ToolTip.Tip="Paste"
                    AutomationProperties.AutomationId="ToolBarPaste"
                    Command="{Binding PasteCommand}"
                    Padding="4,2">
                <PathIcon Width="20" Height="20"
                          Data="M19,2H14.82C14.4,0.84 13.3,0 12,0C10.7,0 9.6,0.84 9.18,2H5C3.9,2 3,2.9 3,4V20C3,21.1 3.9,22 5,22H19C20.1,22 21,21.1 21,20V4C21,2.9 20.1,2 19,2M12,2C12.55,2 13,2.45 13,3C13,3.55 12.55,4 12,4C11.45,4 11,3.55 11,3C11,2.45 11.45,2 12,2M19,20H5V4H7V7H17V4H19V20Z"/>
            </Button>
            <Separator/>
            <Button ToolTip.Tip="Verify"
                    AutomationProperties.AutomationId="ToolBarVerify"
                    Command="{Binding VerifyCommand}"
                    Padding="4,2">
                <PathIcon Width="20" Height="20"
                          Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M10,17L5,12L6.41,10.59L10,14.17L17.59,6.59L19,8L10,17Z"/>
            </Button>
            <Separator/>
            <Button ToolTip.Tip="Store Settings"
                    AutomationProperties.AutomationId="ToolBarStoreSettings"
                    Command="{Binding StoreSettingsCommand}"
                    Padding="4,2">
                <PathIcon Width="20" Height="20"
                          Data="M17,3H7C5.89,3 5,3.89 5,5V19L12,16L19,19V5C19,3.89 18.1,3 17,3Z"/>
            </Button>
            <Button ToolTip.Tip="Load Settings"
                    AutomationProperties.AutomationId="ToolBarLoadSettings"
                    Command="{Binding LoadSettingsCommand}"
                    Padding="4,2">
                <PathIcon Width="20" Height="20"
                          Data="M19,18H5V8H19V18M19,6H5C3.89,6 3,6.89 3,8V19.41C3,19.75 3.15,20.06 3.4,20.27C3.64,20.5 3.99,20.56 4.28,20.44L11,17.6L17.72,20.44C17.83,20.48 17.95,20.5 18,20.5C18.28,20.5 18.55,20.38 18.73,20.17C18.92,19.95 19,19.67 19,19.41V8C19,6.89 18.11,6 17,6Z"/>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
