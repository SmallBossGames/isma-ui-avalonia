<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ISMA.App.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="ISMA.App.Views.IsmaToolBarView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
        <StackPanel Orientation="Horizontal"
                    Spacing="2"
                    Margin="2,0">
            <Button ToolTip.Tip="New model"
                    AutomationProperties.AutomationId="ToolBarNewText"
                    Command="{Binding NewTextCommand}"
                    Padding="4,2">
                <ic:FluentIcon Icon="AddCircle" IconVariant="Regular"/>
            </Button>
            <Button ToolTip.Tip="New statechart"
                    AutomationProperties.AutomationId="ToolBarNewBlueprint"
                    Command="{Binding NewBlueprintCommand}"
                    Padding="4,2">
                <ic:FluentIcon Icon="AddSquare" IconVariant="Regular"/>
            </Button>
            <Button ToolTip.Tip="Open model"
                    AutomationProperties.AutomationId="ToolBarOpen"
                    Command="{Binding OpenCommand}"
                    Padding="4,2">
                <ic:FluentIcon Icon="OpenFolder" IconVariant="Regular"/>
            </Button>
            <Button ToolTip.Tip="Save current model"
                    AutomationProperties.AutomationId="ToolBarSave"
                    Command="{Binding SaveCommand}"
                    Padding="4,2">
                <ic:FluentIcon Icon="Save" IconVariant="Regular"/>
            </Button>
            <Button ToolTip.Tip="Save all models"
                    AutomationProperties.AutomationId="ToolBarSaveAll"
                    Command="{Binding SaveAllCommand}"
                    Padding="4,2">
                <ic:FluentIcon Icon="SaveMultiple" IconVariant="Regular"/>
            </Button>
            <Separator/>
            <Button ToolTip.Tip="Cut"
                    AutomationProperties.AutomationId="ToolBarCut"
                    Command="{Binding CutCommand}"
                    Padding="4,2">
                <ic:FluentIcon Icon="Cut" IconVariant="Regular"/>
            </Button>
            <Button ToolTip.Tip="Copy"
                    AutomationProperties.AutomationId="ToolBarCopy"
                    Command="{Binding CopyCommand}"
                    Padding="4,2">
                <ic:FluentIcon Icon="Copy" IconVariant="Regular"/>
            </Button>
            <Button ToolTip.Tip="Paste"
                    AutomationProperties.AutomationId="ToolBarPaste"
                    Command="{Binding PasteCommand}"
                    Padding="4,2">
                <ic:FluentIcon Icon="ClipboardPaste" IconVariant="Regular"/>
            </Button>
            <Separator/>
            <Button ToolTip.Tip="Verify"
                    AutomationProperties.AutomationId="ToolBarVerify"
                    Command="{Binding VerifyCommand}"
                    Padding="4,2">
                <ic:FluentIcon Icon="CheckmarkCircle" IconVariant="Regular"/>
            </Button>
            <Separator/>
            <Button ToolTip.Tip="Store Settings"
                    AutomationProperties.AutomationId="ToolBarStoreSettings"
                    Command="{Binding StoreSettingsCommand}"
                    Padding="4,2">
                <ic:FluentIcon Icon="Bookmark" IconVariant="Regular"/>
            </Button>
            <Button ToolTip.Tip="Load Settings"
                    AutomationProperties.AutomationId="ToolBarLoadSettings"
                    Command="{Binding LoadSettingsCommand}"
                    Padding="4,2">
                <ic:FluentIcon Icon="FolderOpen" IconVariant="Regular"/>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
