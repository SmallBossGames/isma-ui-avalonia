<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ISMA.ViewModels.ViewModels"
        xmlns:views="using:ISMA.App.Views"
        xmlns:m="using:ISMA.Domain.Models"
        x:Class="ISMA.App.MainWindow"
        x:CompileBindings="True"
        x:DataType="vm:MainWindowViewModel"
        Title="ISMA"
        MinWidth="500" MinHeight="600">
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0">
            <views:IsmaMenuBarView x:Name="MenuBar" />
            <views:IsmaToolBarView x:Name="ToolBar" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,240">
            <views:EditorTabPaneView x:Name="EditorTabPane" AutomationProperties.AutomationId="EditorTabPane" Grid.Column="0" />
            
            <ContentControl x:Name="SettingsPanel" Grid.Column="1"
                            AutomationProperties.AutomationId="SettingsPanel"
                            Content="{Binding SimulationParameters}"
                            IsVisible="{Binding ShowSettings}" />
        </Grid>

        <Border Grid.Row="2" Height="180"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <StackPanel>
                <DataGrid x:Name="ErrorList" AutomationProperties.AutomationId="ErrorList" ItemsSource="{Binding ErrorList.Errors}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          Height="150">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="5*" Header="Row">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="m:ErrorInfo">
                                    <TextBlock Text="{Binding Row}"
                                               HorizontalAlignment="Right"
                                               Padding="4,2,8,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="5*" Header="Position">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="m:ErrorInfo">
                                    <TextBlock Text="{Binding Position}"
                                               HorizontalAlignment="Right"
                                               Padding="4,2,8,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="10*" Header="Fragment">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="m:ErrorInfo">
                                    <TextBlock Text="{Binding FragmentName}"
                                               Padding="4,2,4,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="80*" Header="Message"
                                            Binding="{Binding Message}" />
                    </DataGrid.Columns>
                </DataGrid>
                <views:SimulationProcessBarView x:Name="ProcessBar" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
