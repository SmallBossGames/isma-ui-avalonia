<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ISMA.ViewModels.ViewModels"
             x:Class="ISMA.App.Views.IsmaToolBarView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
        <StackPanel Orientation="Horizontal"
                    Spacing="2"
                    Margin="2,0">
            <Button ToolTip.Tip="New Text Model"
                    Command="{Binding NewTextCommand}"
                    Content="New Text"
                    Padding="8,4"/>
            <Button ToolTip.Tip="New Statechart"
                    Command="{Binding NewBlueprintCommand}"
                    Content="New Blueprint"
                    Padding="8,4"/>
            <Button ToolTip.Tip="Open Model"
                    Command="{Binding OpenCommand}"
                    Content="Open"
                    Padding="8,4"/>
            <Button ToolTip.Tip="Save Current"
                    Command="{Binding SaveCommand}"
                    Content="Save"
                    Padding="8,4"/>
            <Button ToolTip.Tip="Save All"
                    Command="{Binding SaveAllCommand}"
                    Content="Save All"
                    Padding="8,4"/>
            <Separator/>
            <Button ToolTip.Tip="Cut"
                    Command="{Binding CutCommand}"
                    Content="Cut"
                    Padding="8,4"/>
            <Button ToolTip.Tip="Copy"
                    Command="{Binding CopyCommand}"
                    Content="Copy"
                    Padding="8,4"/>
            <Button ToolTip.Tip="Paste"
                    Command="{Binding PasteCommand}"
                    Content="Paste"
                    Padding="8,4"/>
            <Separator/>
            <Button ToolTip.Tip="Verify"
                    Command="{Binding VerifyCommand}"
                    Content="Verify"
                    Padding="8,4"/>
            <Separator/>
            <Button ToolTip.Tip="Store Settings"
                    Command="{Binding StoreSettingsCommand}"
                    Content="Store"
                    Padding="8,4"/>
            <Button ToolTip.Tip="Load Settings"
                    Command="{Binding LoadSettingsCommand}"
                    Content="Load"
                    Padding="8,4"/>
        </StackPanel>
    </Border>
</UserControl>
