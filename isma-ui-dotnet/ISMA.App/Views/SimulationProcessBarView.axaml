<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ISMA.ViewModels.ViewModels"
             xmlns:views="using:ISMA.App.Views"
             x:Class="ISMA.App.Views.SimulationProcessBarView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">
    <StackPanel Orientation="Horizontal"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                Height="32"
                Spacing="4"
                Margin="4">
        <Button ToolTip.Tip="Run Simulation"
                Command="{Binding RunCommand}"
                Width="28" Height="28"
                Padding="0">
            <TextBlock Text="" FontFamily="avares://ISMA.App/Assets/#MaterialDesignIcons" FontSize="18" />
        </Button>

        <Button ToolTip.Tip="Simulation Tasks"
                Width="28" Height="28"
                Padding="0">
            <TextBlock Text="" FontFamily="avares://ISMA.App/Assets/#MaterialDesignIcons" FontSize="18" />
            <Button.Flyout>
                <Flyout>
                    <views:TasksPopOverView DataContext="{Binding TasksPopOver}" />
                </Flyout>
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
