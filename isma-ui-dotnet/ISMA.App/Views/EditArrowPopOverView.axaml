<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ISMA.ViewModels.ViewModels"
             x:Class="ISMA.App.Views.EditArrowPopOverView"
             x:CompileBindings="True"
             x:DataType="vm:EditArrowPopOverViewModel">

    <Border CornerRadius="5"
            Padding="10"
            MinWidth="300"
            MaxWidth="400"
            Background="{DynamicResource SystemControlBackgroundChromeMediumHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="1"
            PointerExited="OnPointerExited">
        <Border.BoxShadow>
            <BoxShadow Offset="0 4 12 0"
                       Color="#D3D3D3"
                       Opacity="0.8"/>
        </Border.BoxShadow>

        <StackPanel Spacing="8">
            <TextBlock Text="Edit Transition"
                       FontWeight="Bold"
                       FontSize="13"
                       Margin="0,0,0,4"/>

            <StackPanel Spacing="4">
                <TextBlock Text="Alias (optional):"
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                <TextBox Text="{Binding Alias, Mode=TwoWay}"
                         FontSize="11"
                         MinHeight="28"
                         Watermark="Enter alias..."/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Predicate:"
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                <TextBox Text="{Binding Predicate, Mode=TwoWay}"
                         FontSize="11"
                         MinHeight="60"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Watermark="Enter predicate condition..."/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        Margin="0,4,0,0">
                <Button Content="OK"
                        Padding="16,4"
                        FontSize="11"
                        Click="OnOkClick"/>
                <Button Content="Cancel"
                        Padding="16,4"
                        FontSize="11"
                        Click="OnCancelClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
