<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ISMA.ViewModels.ViewModels"
             x:Class="ISMA.App.Views.IsmaMenuBarView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">
    <MenuBar Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
        <MenuBar.InputBindings>
            <KeyBinding Command="{Binding NewTextCommand}" Gesture="Ctrl+N" />
            <KeyBinding Command="{Binding NewBlueprintCommand}" Gesture="Ctrl+B" />
            <KeyBinding Command="{Binding OpenCommand}" Gesture="Ctrl+O" />
            <KeyBinding Command="{Binding SaveCommand}" Gesture="Ctrl+S" />
            <KeyBinding Command="{Binding CloseCommand}" Gesture="Ctrl+W" />
            <KeyBinding Command="{Binding CutCommand}" Gesture="Ctrl+X" />
            <KeyBinding Command="{Binding CopyCommand}" Gesture="Ctrl+C" />
            <KeyBinding Command="{Binding PasteCommand}" Gesture="Ctrl+V" />
            <KeyBinding Command="{Binding VerifyCommand}" Gesture="F4" Modifiers="Ctrl" />
            <KeyBinding Command="{Binding RunCommand}" Gesture="F5" Modifiers="Ctrl" />
        </MenuBar.InputBindings>

        <MenuItem Header="_File">
            <MenuItem Header="_New Text" Command="{Binding NewTextCommand}" InputGesture="Ctrl+N" />
            <MenuItem Header="New S_tatechart" Command="{Binding NewBlueprintCommand}" InputGesture="Ctrl+B" />
            <MenuItem Header="_Open..." Command="{Binding OpenCommand}" InputGesture="Ctrl+O" />
            <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
            <MenuItem Header="Save _All" Command="{Binding SaveAllCommand}" />
            <MenuItem Header="_Close" Command="{Binding CloseCommand}" InputGesture="Ctrl+W" />
            <MenuItem Header="Close _All" Command="{Binding CloseAllCommand}" />
            <Separator />
            <MenuItem Header="E_xit" Command="{Binding ExitCommand}" InputGesture="Ctrl+W" />
        </MenuItem>

        <MenuItem Header="_Edit">
            <MenuItem Header="Cu_t" Command="{Binding CutCommand}" InputGesture="Ctrl+X" />
            <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGesture="Ctrl+C" />
            <MenuItem Header="_Paste" Command="{Binding PasteCommand}" InputGesture="Ctrl+V" />
        </MenuItem>

        <MenuItem Header="_Simulation">
            <MenuItem Header="_Verify" Command="{Binding VerifyCommand}" InputGesture="Ctrl+F4" />
            <MenuItem Header="_Run" Command="{Binding RunCommand}" InputGesture="Ctrl+F5" />
            <Separator />
            <MenuItem Header="_Store Settings" Command="{Binding StoreSettingsCommand}" />
            <MenuItem Header="_Load Settings" Command="{Binding LoadSettingsCommand}" />
        </MenuItem>
    </MenuBar>
</UserControl>
