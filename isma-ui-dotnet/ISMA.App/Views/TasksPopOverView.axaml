<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ISMA.ViewModels.ViewModels"
             x:Class="ISMA.App.Views.TasksPopOverView"
             x:CompileBindings="True"
             x:DataType="vm:TasksPopOverViewModel">
    <StackPanel Margin="8" Spacing="8" MinWidth="300">
        <TextBlock Text="In Progress" FontWeight="Bold" FontSize="14" />
        <ListBox ItemsSource="{Binding InProgress}" MinHeight="100" MaxHeight="200">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:InProgressSimulationViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="{Binding Progress}" HorizontalAlignment="Right" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="Completed" FontWeight="Bold" FontSize="14" />
        <ListBox ItemsSource="{Binding Completed}" MinHeight="50" MaxHeight="150">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CompletedSimulation">
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
