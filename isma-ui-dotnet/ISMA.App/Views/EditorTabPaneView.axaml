<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ISMA.ViewModels.ViewModels"
             x:Class="ISMA.App.Views.EditorTabPaneView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">
    <TabControl ItemsSource="{Binding Projects}"
                SelectedItem="{Binding ActiveProject}">
        <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:IProjectViewModel">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text=" *" IsVisible="{Binding IsDirty}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
                </StackPanel>
            </DataTemplate>
        </TabControl.ItemTemplate>

        <TabControl.ContentTemplate>
            <DataTemplate x:DataType="vm:IProjectViewModel">
                <ContentControl Content="{Binding EditorContent}" />
            </DataTemplate>
        </TabControl.ContentTemplate>

        <TabControl.Commands>
            <RoutedCommand x:Name="CloseTabCommand" />
        </TabControl.Commands>
    </TabControl>
</UserControl>
