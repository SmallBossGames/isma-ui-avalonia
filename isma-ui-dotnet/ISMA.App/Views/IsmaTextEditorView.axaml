<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editors="using:AvaloniaEdit"
             xmlns:vm="using:ISMA.ViewModels.ViewModels"
             x:Class="ISMA.App.Views.IsmaTextEditorView"
             x:CompileBindings="True"
             x:DataType="vm:LismaProjectViewModel">
    <Panel>
        <editors:TextEditor x:Name="Editor"
                            FontFamily="Consolas, Cascadia Code, Courier New"
                            FontSize="12"
                            ShowLineNumbers="True"
                            Background="{DynamicResource SurfaceColor}"
                            Foreground="{DynamicResource PrimaryTextColor}"
                            Text="{Binding FullText, Mode=TwoWay}"
                            TextArea.TextCopied="OnTextCopied"
                            TextArea.TextCut="OnTextCut"
                            TextArea.TextPasted="OnTextPasted"
                            TextArea.TextEntering="OnTextEntering"
                            TextArea.TextChanged="OnTextChanged"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            WordWrap="False"
                            Options="ShowEndOfLine,ShowSpaces,ShowTabs,EnableLeftRightArrows,EnableHorizontalScrolling,EnableInvalidLines"
                            DataContext="{Binding}">
            <editors:TextEditor.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Cut"
                              Command="{Binding CutCommand}"
                              InputGesture="Ctrl+X" />
                    <MenuItem Header="Copy"
                              Command="{Binding CopyCommand}"
                              InputGesture="Ctrl+C" />
                    <MenuItem Header="Paste"
                              Command="{Binding PasteCommand}"
                              InputGesture="Ctrl+V" />
                    <Separator />
                    <MenuItem Header="Select All"
                              Command="{Binding SelectAllCommand}"
                              InputGesture="Ctrl+A" />
                    <MenuItem Header="Find and Replace"
                              Command="{Binding FindReplaceCommand}" />
                </ContextMenu>
            </editors:TextEditor.ContextMenu>
        </editors:TextEditor>

        <TextBlock x:Name="SyntaxStatus"
                   Panel.ZIndex="1"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Padding="6,2"
                   FontSize="10"
                   Foreground="{DynamicResource SecondaryTextColor}"
                   Background="{DynamicResource SurfaceColor}"
                   IsVisible="{Binding IsHighlighting, Mode=OneWay}"
                   Text="Highlighting...">
            <TextBlock.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="CornerRadius" Value="3" />
                </Style>
            </TextBlock.Styles>
        </TextBlock>
    </Panel>
</UserControl>
